#!/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin;

echo '=============================================================';
echo ' [LNMP/Nginx] Amysql Host - AMH 4.2 ';
echo ' http://Amysql.com';
echo '';

function AllManagement()
{
	if [ "$1" != '' ]; then
		selected=$1;
	else
		echo "[AMH] ALL Management please select: (1~4)"
		select selected in 'restart' 'exit'; do break; done;
	fi;

	[ "$selected" == 'exit' ] && exit;
	if [ "$selected" == 'restart' ]; then
		/etc/init.d/amh-start;
		ps x | grep 'nginx:' | grep -v 'grep' >/dev/null && echo "[OK] All restart";
	else
		NginxManagement;
		return;
	fi;
}
AllManagement $1;
