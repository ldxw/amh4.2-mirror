          {
              "myapp": {
                  "master": {
                      "master_0": {
                          "host": "localhost"
                      }
                  },
                  "slave": {
                      "slave_0": {
                          "host": "192.168.2.27",
                          "port": "3306"
                      },
                      "slave_1": {
                          "host": "192.168.78.136",
                          "port": "3306"
                      }
                  },
                  "filters": {
                      "user": {
                          "callback": "pick_server"
                      }
                  }
              }
