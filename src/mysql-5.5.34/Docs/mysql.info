       array(8) {
         ["query"]=>
         string(26) "SELECT 1 AS _one FROM DUAL"
         ["origin"]=>
         string(102) "#0 qc.php(7): mysqli->query('SELECT 1 AS _on...')
     #1 {main}"
         ["run_time"]=>
         int(0)
         ["store_time"]=>
         int(25)
         ["eligible_for_caching"]=>
