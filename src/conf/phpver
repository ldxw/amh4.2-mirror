#!/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin;

echo '=============================================================';
echo ' [LNMP/Nginx] Amysql Host - AMH 4.2 ';
echo ' http://Amysql.com';
echo '';

# 面板基础版本 5.3 用 /usr/local/php，其它版本用 /usr/local/php<版本号>
PHPVersions='5.3 5.4 5.5 5.6 7.0 7.1 7.2 7.3 7.4 8.0 8.1 8.2 8.3 8.4 8.5';

function PHPVersionManagement()
{
	if [ "$*" != '' ]; then
		selected=$1;
		domain=$2;
	else
		echo "[AMH] PHP 版本管理，请选择: (1~15)"
		select selected in $PHPVersions 'exit'; do break; done;
	fi;

	[ "$selected" == 'exit' ] && exit;
	[ "$selected" == '' ] && { PHPVersionManagement; return; };

	[ "$domain" == '' ] && read -p "[Notice] 请输入域名:" domain
	[ "$domain" == '' ] && echo '[error] 域名不能为空' && exit 1;

	# 5.3 是面板基础版本，目录不带版本号
	if [ "$selected" == '5.3' ]; then
		phpdir='/usr/local/php';
	else
		phpdir="/usr/local/php${selected}";
	fi;

	[ ! -d "$phpdir" ] && echo "[error] PHP ${selected} 未安装" && exit 1;

	echo "[Notice] ${domain} 的 PHP 版本将切换到 ${selected} ...";

	[ ! -f "/root/amh/sitesconf/${domain}.conf" ] && touch "/root/amh/sitesconf/${domain}.conf";
	sed -i '/^phpver.*/d' "/root/amh/sitesconf/${domain}.conf";
	echo "phpver=${selected}" >> "/root/amh/sitesconf/${domain}.conf";

	echo "[OK] ${domain} 已切换为 PHP ${selected}（/root/amh/sitesconf/${domain}.conf）";
	/root/amh/php restart;
}
PHPVersionManagement $*;
